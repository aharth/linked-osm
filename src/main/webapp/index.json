{
  "resources": {
    "node": {
      "hrefTemplate": "/node/{id}{.format}",
      "hrefVars": {
        "id": "OSM node ID",
        "format": "rdf (default) or json (GeoJSON)"
      },
      "hints": {
        "allow": ["GET"]
      }
    },
    "way": {
      "hrefTemplate": "/way/{id}{.format}",
      "hrefVars": {
        "id": "OSM way ID",
        "format": "rdf (default) or json (GeoJSON)"
      },
      "hints": {
        "allow": ["GET"]
      }
    },
    "relation": {
      "hrefTemplate": "/relation/{id}{.format}",
      "hrefVars": {
        "id": "OSM relation ID",
        "format": "rdf (default) or json (GeoJSON)"
      },
      "hints": {
        "allow": ["GET"]
      }
    },
    "changeset": {
      "hrefTemplate": "/changeset/{id}{.format}",
      "hrefVars": {
        "id": "OSM changeset ID",
        "format": "rdf (default)"
      },
      "hints": {
        "allow": ["GET"]
      }
    },
    "geo-osm": {
      "hrefTemplate": "/geo/osm/{type}/{id}{.format}",
      "hrefVars": {
        "type": "node, way, or relation",
        "id": "OSM element ID",
        "format": "json (GeoJSON, default), wkt, or kml"
      },
      "hints": {
        "allow": ["GET"]
      }
    },
    "geo-overpass": {
      "hrefTemplate": "/geo/overpass/{type}/{id}{.format}",
      "hrefVars": {
        "type": "node, way, or relation",
        "id": "OSM element ID",
        "format": "json (GeoJSON, default), wkt, or kml"
      },
      "hints": {
        "allow": ["GET"]
      }
    },
    "search": {
      "hrefTemplate": "/search{?q}",
      "hrefVars": {
        "q": "search query (Nominatim)"
      },
      "hints": {
        "allow": ["GET"]
      }
    },
    "map": {
      "hrefTemplate": "/map{?bbox}",
      "hrefVars": {
        "bbox": "bounding box as west,south,east,north"
      },
      "hints": {
        "allow": ["GET"]
      }
    },
    "poi": {
      "hrefTemplate": "/poi{?bbox}",
      "hrefVars": {
        "bbox": "bounding box as west,south,east,north"
      },
      "hints": {
        "allow": ["GET"]
      }
    },
    "around": {
      "hrefTemplate": "/around{?lon,lat}{&radius}",
      "hrefVars": {
        "lon": "WGS84 longitude",
        "lat": "WGS84 latitude",
        "radius": "search radius in meters (default 1000)"
      },
      "hints": {
        "allow": ["GET"]
      }
    },
    "tag": {
      "hrefTemplate": "/tag/{key}{.format}",
      "hrefVars": {
        "key": "OSM tag key (e.g. amenity, highway) or 'index' for all keys",
        "format": "rdf (SKOS/RDF, default) or json (SKOS JSON-LD)"
      },
      "hints": {
        "allow": ["GET"]
      }
    }
  }
}
