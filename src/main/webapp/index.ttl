@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# </#osmwrap>, not <#osmwrap>: the bare fragment was base-sensitive, so dropping
# the @base would have moved the agent to <index.ttl#osmwrap>. The absolute-path
# form is host-free AND keeps the exact IRI the XSL stylesheets already emit
# (common.xsl, search.xsl, map.xsl, poi.xsl, changeset.xsl all write /#osmwrap).
</#osmwrap> a prov:SoftwareAgent ;
    rdfs:label "Linked OSM (osmwrap)" ;
    foaf:page <index.html> .
